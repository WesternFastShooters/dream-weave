{
  "name": "@dream-weave/canvas-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @dream-weave/canvas-renderer... --filter @dream-weave/creative-nodes... run build && vite",
