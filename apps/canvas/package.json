    "@dream-weave/di": "workspace:*",
    "@milkdown/core": "7.21.3",
    "@milkdown/crepe": "7.21.3",
    "@milkdown/prose": "7.21.3",
    "@milkdown/utils": "7.21.3",
    "@xyflow/react": "^12.10.2",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@playwright/test": "^1.61.1",
